"""Forward kinematics for the planar 3-DOF arm (three revolute joints, all in one plane)."""
import numpy as np
from src.config import LINKS_3DOF


def forward_kinematics(thetas, links=LINKS_3DOF):
    """Return the end-effector pose [x, y, phi].

    phi is the absolute angle of the last link, so phi = t1 + t2 + t3.
    """
    t1, t2, t3 = thetas
    l1, l2, l3 = links

    a1 = t1
    a2 = t1 + t2
    a3 = t1 + t2 + t3

    x = l1 * np.cos(a1) + l2 * np.cos(a2) + l3 * np.cos(a3)
    y = l1 * np.sin(a1) + l2 * np.sin(a2) + l3 * np.sin(a3)
    return np.array([x, y, a3])


def joint_positions(thetas, links=LINKS_3DOF):
    """Coordinates of base, joint 2, joint 3 and the tip. Handy for plotting."""
    t1, t2, t3 = thetas
    pts = [np.zeros(2)]
    angle = 0.0
    for t, l in zip((t1, t2, t3), links):
        angle += t
        pts.append(pts[-1] + l * np.array([np.cos(angle), np.sin(angle)]))
    return np.array(pts)


