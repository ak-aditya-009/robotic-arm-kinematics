import numpy as np


def dh_matrix(theta, d, a, alpha):
    """Standard DH transform from frame i-1 to frame i."""
    ct, st = np.cos(theta), np.sin(theta)
    ca, sa = np.cos(alpha), np.sin(alpha)
    return np.array([
        [ct, -st * ca,  st * sa, a * ct],
        [st,  ct * ca, -ct * sa, a * st],
        [0.0,      sa,       ca,      d],
        [0.0,     0.0,      0.0,    1.0],
    ])


def chain(dh_rows):
    """Multiply a list of (theta, d, a, alpha) rows into one base->tip transform."""
    T = np.eye(4)
    for theta, d, a, alpha in dh_rows:
        T = T @ dh_matrix(theta, d, a, alpha)
    return T
